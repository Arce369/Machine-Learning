        "#@title TOP 5 (Bar Charts)\n",
        "# ============================================================\n",
        "# 8. TOP 5 MOST LIKELY SCORELINES PER MODEL (BAR CHARTS)\n",
        "# ============================================================\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def top_scorelines(M, n=5):\n",
        "    \"\"\"From a probability matrix (rows=home goals, cols=away goals),\n",
        "    returns the n most likely scorelines as a list of (home_goals, away_goals, prob).\"\"\"\n",
        "    if M is None:\n",
        "        return None\n",
        "    flat_idx = np.argsort(M.ravel())[::-1][:n]\n",
        "    rows, cols = np.unravel_index(flat_idx, M.shape)\n",
        "    return [(int(r), int(c), float(M[r, c])) for r, c in zip(rows, cols)]\n",
        "\n",
        "\n",
        "def plot_top_scorelines(model_name, M, home_team, away_team, n=5, color='#04f5ff'):\n",
        "    \"\"\"Plots a horizontal bar chart with the n most likely scorelines for a single model.\"\"\"\n",
        "    top = top_scorelines(M, n)\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(6, 4))\n",
        "\n",
        "    if top is None:\n",
        "        ax.text(0.5, 0.5, 'Not available\\n(insufficient data for this team)',\n",
        "                ha='center', va='center', fontsize=12, transform=ax.transAxes)\n",
        "        ax.set_xticks([]); ax.set_yticks([])\n",
        "        ax.set_title(f'Top {n} Most Likely Scorelines ({model_name})', fontsize=13, fontweight='bold')\n",
        "        return fig, None\n",
        "\n",
        "    labels = [f'{home_team} {h}-{a} {away_team}' for h, a, _ in top]\n",
        "    probs = [p for _, _, p in top]\n",
        "\n",
        "    # Reverse so the most likely scoreline appears at the top of the chart\n",
        "    labels = labels[::-1]\n",
        "    probs = probs[::-1]\n",
        "\n",
        "    bars = ax.barh(labels, probs, color=color, alpha=0.85, edgecolor='black', linewidth=0.5)\n",
        "    ax.set_xlabel('Probability', fontsize=11)\n",
        "    ax.set_title(f'Top {n} Most Likely Scorelines ({model_name})', fontsize=13, fontweight='bold')\n",
        "    ax.xaxis.set_major_formatter(plt.FuncFormatter(lambda x, _: f'{x:.0%}'))\n",
        "\n",
        "    for bar, p in zip(bars, probs):\n",
        "        ax.text(bar.get_width() + max(probs) * 0.02, bar.get_y() + bar.get_height() / 2,\n",
        "                f'{p:.2%}', va='center', fontsize=10)\n",
        "\n",
        "    ax.set_xlim(0, max(probs) * 1.2)\n",
        "    fig.tight_layout()\n",
        "    return fig, top\n",
        "\n",
        "\n",
        "def plot_all_models_top_scorelines(home_team, away_team, M_dc, M_mc, M_xgb, n=5):\n",
        "    \"\"\"Plots side-by-side bar charts for the top n scorelines of all three models.\"\"\"\n",
        "    models = [\n",
        "        ('Dixon-Coles', M_dc, '#04f5ff'),\n",
        "        ('MCMC', M_mc, '#00ff85'),\n",
        "        ('XGBoost', M_xgb, '#e90052'),\n",
        "    ]\n",
        "\n",
        "    fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
        "    tops = {}\n",
        "\n",
        "    for ax, (model_name, M, color) in zip(axes, models):\n",
        "        top = top_scorelines(M, n)\n",
        "        tops[model_name] = top\n",
        "\n",
        "        if top is None:\n",
        "            ax.text(0.5, 0.5, 'Not available\\n(insufficient data for this team)',\n",
        "                    ha='center', va='center', fontsize=11, transform=ax.transAxes)\n",
        "            ax.set_xticks([]); ax.set_yticks([])\n",
        "            ax.set_title(f'{model_name}', fontsize=13, fontweight='bold')\n",
        "            continue\n",
        "\n",
        "        labels = [f'{h}-{a}' for h, a, _ in top][::-1]\n",
        "        probs = [p for _, _, p in top][::-1]\n",
        "\n",
        "        bars = ax.barh(labels, probs, color=color, alpha=0.85, edgecolor='black', linewidth=0.5)\n",
