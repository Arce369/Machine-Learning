        "# ------------------------------------------------------------\n",
        "def show_matrix_gif(matrix, home_team, away_team, model_name, fps=1, loop=0):\n",
        "    \"\"\"\n",
        "    matrix: matriz de probabilidad ya normalizada, de cualquiera de tus modelos:\n",
        "        - dc_matrix(dcm, home_team, away_team, host)\n",
