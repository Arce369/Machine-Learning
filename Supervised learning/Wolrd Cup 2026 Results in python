        "#@title Models\n",
        "# ------------------------------------------------------------\n",
        "# 9. DIXON-COLES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def fit_dixon_coles(train, cutoff, half_life=half_life):\n",
        "    train = train.copy()\n",
        "    train['w'] = 0.5 ** ((cutoff - train['date']).dt.days / half_life)\n",
        "    teams = sorted(set(train['home_team']) | set(train['away_team']))\n",
        "    idx = {t: i for i, t in enumerate(teams)}\n",
        "    n = len(teams)\n",
        "    hi = train['home_team'].map(idx).values\n",
        "    ai = train['away_team'].map(idx).values\n",
        "    hs = train['home_score'].values\n",
        "    as_ = train['away_score'].values\n",
        "    w = train['w'].values\n",
        "    lm = (train['neutral'] == False).values.astype(float)\n",
        "\n",
        "    def tau(x, y, l, m, r):\n",
        "        t = np.ones_like(l)\n",
        "        a = (x == 0) & (y == 0); t[a] = 1 - l[a] * m[a] * r\n",
        "        a = (x == 0) & (y == 1); t[a] = 1 + l[a] * r\n",
        "        a = (x == 1) & (y == 0); t[a] = 1 + m[a] * r\n",
        "        a = (x == 1) & (y == 1); t[a] = 1 - r\n",
        "        return t\n",
        "\n",
        "    def neg_log_likelyhood(p):\n",
        "        at = p[:n] - p[:n].mean()\n",
        "        dn = p[n:2 * n]\n",
        "        h = p[2 * n]\n",
        "        r = p[2 * n + 1]\n",
        "        l = np.exp(at[hi] - dn[ai] + h * lm)\n",
        "        m = np.exp(at[ai] - dn[hi])\n",
        "        t = np.clip(tau(hs, as_, l, m, r), 1e-10, None)\n",
        "        return -(w * (np.log(t) + poisson.logpmf(hs, l) + poisson.logpmf(as_, m))).sum()\n",
        "\n",
        "    r = minimize(neg_log_likelyhood, np.concatenate([np.zeros(n), np.zeros(n), [.25, -.05]]), method='L-BFGS-B')\n",
        "    at = r.x[:n] - r.x[:n].mean()\n",
        "    return {'att': at, 'dfn': r.x[n:2 * n], 'home': r.x[2 * n], 'rho': r.x[2 * n + 1],\n",
        "            'ic': r.fun, 'idx': idx, 'teams': teams}\n",
        "\n",
        "\n",
        "def dc_matrix(dcm, h, a, host):\n",
        "    att, dfn, idx, home, rho = dcm['att'], dcm['dfn'], dcm['idx'], dcm['home'], dcm['rho']\n",
        "    l = np.exp(att[idx[h]] - dfn[idx[a]] + (home if host else 0))\n",
        "    m = np.exp(att[idx[a]] - dfn[idx[h]])\n",
        "    M = np.outer(poisson.pmf(range(maxGoals), l), poisson.pmf(range(maxGoals), m))\n",
        "    M[0, 0] *= 1 - l * m * rho\n",
        "    M[0, 1] *= 1 + l * rho\n",
        "    M[1, 0] *= 1 + m * rho\n",
        "    M[1, 1] *= 1 - rho\n",
        "    return M / M.sum()\n",
        "\n",
        "\n",
        "def matrix_to_1x2(M):\n",
        "    return [\n",
        "        np.tril(M, -1).sum(),   # P(home win)\n",
        "        np.trace(M),            # P(draw)\n",
        "        np.triu(M, 1).sum()     # P(away win)\n",
        "    ]\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. MCMC\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def fit_mcmc(train, draws=1000, tune=1000, seed=1):\n",
        "    counts = pd.concat([train.home_team, train.away_team]).value_counts()\n",
        "    keep = set(counts[counts >= min_matches_bayes].index)\n",
        "\n",
        "    tb = train[train.home_team.isin(keep) & train.away_team.isin(keep)]\n",
        "    teams = sorted(keep)\n",
        "    idxb = {t: i for i, t in enumerate(teams)}\n",
        "    n = len(teams)\n",
        "\n",
        "    hi = tb.home_team.map(idxb).values\n",
        "    ai = tb.away_team.map(idxb).values\n",
        "    hs = tb.home_score.values\n",
        "    as_ = tb.away_score.values\n",
        "    lm = (tb.neutral == False).values.astype(float)\n",
        "\n",
        "    with pm.Model():\n",
        "        sa = pm.HalfNormal('sa', 1.0)\n",
        "        sd = pm.HalfNormal('sd', 1.0)\n",
        "\n",
        "        # Parametrización NO centrada: evita la geometría de \"funnel\" que\n",
        "        # hace que NUTS necesite pasos diminutos. Es matemáticamente\n",
        "        # equivalente a Normal(0, sa) pero muestrea mucho más rápido.\n",
        "        att_raw = pm.Normal('att_raw', 0, 1, shape=n)\n",
        "        dfn_raw = pm.Normal('dfn_raw', 0, 1, shape=n)\n",
        "        att = pm.Deterministic('att', att_raw * sa)\n",
        "        dfn = pm.Deterministic('dfn', dfn_raw * sd)\n",
        "\n",
        "        home = pm.Normal('home', 0.25, 0.5)\n",
        "        base = pm.Normal('base', 0, 0.5)\n",
        "\n",
        "        ac = att - att.mean()\n",
        "        dc = dfn - dfn.mean()\n",
        "\n",
        "        pm.Poisson('gh', pm.math.exp(base + home * lm + ac[hi] - dc[ai]), observed=hs)\n",
        "        pm.Poisson('ga', pm.math.exp(base + ac[ai] - dc[hi]), observed=as_)\n",
        "\n",
        "        # Intenta usar un sampler compilado (mucho más rápido). Si no está\n",
        "        # instalado (pip install nutpie), cae de vuelta al sampler nativo.\n",
        "        try:\n",
        "            trace = pm.sample(draws, tune=tune, chains=4, cores=4,\n",
        "                               nuts_sampler='nutpie',\n",
        "                               progressbar=True, random_seed=seed)\n",
        "        except Exception as e:\n",
        "            print(f'nutpie is not able ({e}), trying native sampler from PymC...')\n",
        "            trace = pm.sample(draws, tune=tune, chains=4, cores=4,\n",
        "                               progressbar=True, random_seed=seed)\n",
        "\n",
        "    return {'trace': trace, 'idxb': idxb, 'keep': keep}\n",
        "\n",
        "\n",
        "def mcmc_matrix_mean(mc, h, a, host):\n",
        "    post = mc['trace'].posterior\n",
        "    idxb = mc['idxb']\n",
        "\n",
        "    if h not in idxb or a not in idxb:\n",
        "        return None\n",
        "\n",
        "    am = post['att'].mean(('chain', 'draw')).values; am-= am.mean()\n",
        "    dm = post['dfn'].mean(('chain', 'draw')).values; dm-= dm.mean()\n",
        "    hm = float(post['home'].mean())\n",
        "    bm = float(post['base'].mean())\n",
        "\n",
        "    l = np.exp(bm + hm * host + am[idxb[h]] - dm[idxb[a]])\n",
        "    m = np.exp(bm + am[idxb[a]] - dm[idxb[h]])\n",
        "\n",
        "    M = np.outer(poisson.pmf(range(maxGoals), l), poisson.pmf(range(maxGoals), m))\n",
        "    return M / M.sum()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 11. CREATE FEATURES & DATASET FOR XGBOOST\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "long = []\n",
        "for r in df_cupper[df_cupper.date >= from_date].itertuples():\n",
        "    long.append((r.date, r.home_team, r.home_score, r.away_score, 1))\n",
        "    long.append((r.date, r.away_team, r.away_score, r.home_score, 0))\n",
        "\n",
        "L = pd.DataFrame(long, columns=['date', 'team', 'gf', 'ga', 'ishome'])\n",
        "L['pts'] = np.where(L.gf > L.ga, 3, np.where(L.gf == L.ga, 1, 0))\n",
        "g = L.groupby('team')\n",
        "L['form5'] = g['pts'].transform(lambda s: s.shift().rolling(5).sum())\n",
        "L['gf5'] = g['gf'].transform(lambda s: s.shift().rolling(5).sum())\n",
        "L['ga5'] = g['ga'].transform(lambda s: s.shift().rolling(5).sum())\n",
        "\n",
        "FORM = {(row.date, row.team, row.ishome): (row.form5, row.gf5, row.ga5)\n",
        "        for row in L.itertuples()}\n",
        "\n",
        "\n",
        "def make_features(dcm, h, a, host, date):\n",
        "    idx = dcm['idx']\n",
        "    if h not in idx or a not in idx:\n",
        "        return None\n",
        "    att, dfn, home = dcm['att'], dcm['dfn'], dcm['home']\n",
        "    lam = np.exp(att[idx[h]] - dfn[idx[a]] + home * host)\n",
        "    mu = np.exp(att[idx[a]] - dfn[idx[h]])\n",
        "\n",
        "    fh = FORM.get((date, h, 1), (1, 1, 1))\n",
        "    fa = FORM.get((date, a, 0), (1, 1, 1))\n",
        "\n",
        "    return [\n",
        "        lam, mu,\n",
        "        att[idx[h]] - att[idx[a]],\n",
        "        fh[0], fh[1], fh[2],\n",
        "        fa[0], fa[1], fa[2]\n",
        "    ]\n",
        "\n",
        "\n",
        "def build_dataset(dcm, fecha_max):\n",
        "    known = set(dcm['teams'])\n",
        "    rows, yh, ya, dates, meta = [], [], [], [], []\n",
        "    sub = df_cupper[(df_cupper.date >= from_date) & (df_cupper.date < fecha_max)]\n",
        "    for r in sub.itertuples():\n",
        "        if r.home_team not in known or r.away_team not in known:\n",
        "            continue\n",
        "        host = 1.0 if r.neutral == False else 0.0\n",
        "        f = make_features(dcm, r.home_team, r.away_team, host, r.date)\n",
        "        if f is None or any(pd.isna(f)):\n",
        "            continue\n",
        "        rows.append(f)\n",
        "        yh.append(r.home_score)\n",
        "        ya.append(r.away_score)\n",
        "        dates.append(r.date)\n",
        "        meta.append((r.home_team, r.away_team))\n",
        "    return np.array(rows), np.array(yh), np.array(ya), np.array(dates), meta\n",
        "\n",
        "\n",
        "FEATURE_NAMES = ['lambda_dc', 'mu_dc', 'att_diff',\n",
        "                  'home_form5', 'home_gf5', 'home_ga5',\n",
        "                  'away_form5', 'away_gf5', 'away_ga5']\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 12. XGBOOST (home/away goals regressor)\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def xgb_matrix(model_h, model_a, dcm, h, a, host, date):\n",
        "    f = make_features(dcm, h, a, host, date)\n",
        "    if f is None:\n",
        "        return None\n",
        "    f = np.array(f).reshape(1, -1)\n",
        "    lam_x = max(float(model_h.predict(f)[0]), 1e-6)\n",
        "    mu_x = max(float(model_a.predict(f)[0]), 1e-6)\n",
        "    M = np.outer(poisson.pmf(range(maxGoals), lam_x), poisson.pmf(range(maxGoals), mu_x))\n",
        "    return M / M.sum()\n"
      ]
    },
