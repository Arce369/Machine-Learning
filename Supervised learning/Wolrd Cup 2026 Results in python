        "    ax1.set_xlabel(f'{away_team} Goals', fontsize=12)\n",
        "    ax1.set_ylabel(f'{home_team} Goals', fontsize=12)\n",
        "    ax1.xaxis.set_label_position('top')\n",
        "    nrows, ncols = matrix.shape\n",
        "    for i in range(nrows):\n",
        "        for j in range(ncols):\n",
        "            c = matrix[i][j]\n",
        "            ax1.text(j, i, str(round(c, 4)), va='center', ha='center', size=8)\n",
        "    plt.figtext(0.5, 0.05, subtitle, horizontalalignment='center',\n",
        "                fontsize=14, multialignment='left', fontweight='bold')\n",
